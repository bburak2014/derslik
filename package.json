{
  "name": "derslik",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/dev.mjs --production",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "pnpm api:test:pglite",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node .api-build/apps/api/src/main.js",
    "api:local": "node --env-file=.env.api .api-build/apps/api/src/main.js",
    "api:migrate": "node --env-file=.env.api .api-build/apps/api/src/db/migrate.js",
    "api:db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "api:setup": "node scripts/setup.mjs",
    "api:test": "pnpm api:build && node apps/api/tests/run.mjs",
    "api:test:pglite": "pnpm api:build && node apps/api/tests/run.mjs --pglite",
    "web:dev": "pnpm --filter @derslik/web dev",
    "web:build": "pnpm --filter @derslik/web build",
    "web:start": "pnpm --filter @derslik/web start",
    "web:test": "node --test tests/web-session.test.mjs tests/web-security-audit.test.mjs",
    "mobile:start": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start",
    "mobile:tunnel": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --tunnel",
    "mobile:localhost": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --localhost",
    "mobile:android": "pnpm --filter @derslik/mobile android",
    "mobile:ios": "pnpm --filter @derslik/mobile ios",
    "mobile:export": "pnpm --filter @derslik/mobile export",
    "mobile:typecheck": "pnpm --filter @derslik/mobile typecheck",
    "mobile:security-test": "node scripts/mobile-security-tests.mjs",
    "setup": "node scripts/setup.mjs",
    "test:teaching": "pnpm api:test:pglite",
    "build:local": "pnpm api:build && pnpm web:build",
    "site:build": "node scripts/run-framework.mjs build",
    "env:sync": "node scripts/sync-env.mjs",
    "db:up": "docker compose --env-file .env.api -f compose.api.yml up -d --wait postgres",
    "test:architecture": "node --test tests/architecture.test.mjs tests/migration-preflight.test.mjs",
    "migration:check": "node scripts/legacy-preflight.mjs",
    "storage:setup": "node --env-file=.env.api apps/api/scripts/setup-storage.mjs",
    "mobile:clear": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --clear",
    "services:check": "node scripts/check-services.mjs",
    "test:media": "pnpm api:build && node --test tests/media-config.test.mjs",
    "test:booking": "node --experimental-strip-types --test tests/booking-rules.test.mjs",
    "quality:sonar": "node scripts/sonar.mjs",
    "quality:dup": "npx -y jscpd@4",
    "security:code": "bash scripts/security-scan.sh code",
    "security:dependencies": "bash scripts/security-scan.sh dependencies",
    "security:web": "bash scripts/security-scan.sh web",
    "security:mobile": "bash scripts/security-scan.sh mobile",
    "security:mobile:stop": "bash scripts/security-scan.sh mobile-stop",
    "security:status": "bash scripts/security-scan.sh status",
    "security:fixture": "pnpm api:build && DERSLIK_SECURITY_FIXTURE_FILE=reports/security/backend-fixture.json DERSLIK_SECURITY_FIXTURE_ONLY=1 node apps/api/tests/run.mjs",
    "security:seeds": "node apps/api/tests/security-zap-seeds.mjs",
    "security:web-fixture": "WEB_SECURITY_FIXTURE=reports/security/backend-fixture.json WEB_SECURITY_BACKEND=http://127.0.0.1:3101 WEB_SECURITY_SESSION=reports/security/web-fixture-session.json node tests/web-security-harness.mjs --serve",
    "security:e2e": "node tests/web-security-e2e.mjs",
    "security:zap:api": "node scripts/security-zap-fixture.mjs api",
    "security:zap:web": "node scripts/security-zap-fixture.mjs web"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
