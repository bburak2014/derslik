{
  "name": "derslik",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/dev.mjs --production",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "pnpm api:test:pglite",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node .api-build/apps/api/src/main.js",
    "api:local": "node --env-file=.env.api .api-build/apps/api/src/main.js",
    "api:migrate": "node --env-file=.env.api .api-build/apps/api/src/db/migrate.js",
    "api:db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "api:setup": "node scripts/setup.mjs",
    "api:test": "pnpm api:build && node apps/api/tests/run.mjs",
    "api:test:pglite": "pnpm api:build && node apps/api/tests/run.mjs --pglite",
    "web:dev": "pnpm --filter @derslik/web dev",
    "web:build": "pnpm --filter @derslik/web build",
    "web:start": "pnpm --filter @derslik/web start",
    "web:test": "node --test tests/web-session.test.mjs",
    "mobile:start": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start",
    "mobile:tunnel": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --tunnel",
    "mobile:localhost": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --localhost",
    "mobile:android": "pnpm --filter @derslik/mobile android",
    "mobile:ios": "pnpm --filter @derslik/mobile ios",
    "mobile:export": "pnpm --filter @derslik/mobile export",
    "mobile:typecheck": "pnpm --filter @derslik/mobile typecheck",
    "setup": "node scripts/setup.mjs",
    "test:teaching": "pnpm api:test:pglite",
    "build:local": "pnpm api:build && pnpm web:build",
    "site:build": "node scripts/run-framework.mjs build",
    "env:sync": "node scripts/sync-env.mjs",
    "db:up": "docker compose --env-file .env.api -f compose.api.yml up -d --wait postgres",
    "test:architecture": "node --test tests/architecture.test.mjs tests/migration-preflight.test.mjs",
    "migration:check": "node scripts/legacy-preflight.mjs",
    "storage:setup": "node --env-file=.env.api apps/api/scripts/setup-storage.mjs",
    "mobile:clear": "node scripts/sync-env.mjs && pnpm --filter @derslik/mobile start --clear",
    "services:check": "node scripts/check-services.mjs",
    "test:media": "pnpm api:build && node --test tests/media-config.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.7.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
