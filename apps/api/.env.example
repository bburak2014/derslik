# Use `node apps/api/scripts/setup-env.mjs` to generate unique passwords in .env.api.
# Do not commit .env.api or real tokens.
POSTGRES_PASSWORD=replace_with_unique_hex_password
API_DATABASE_PASSWORD=replace_with_another_unique_hex_password
POSTGRES_PORT=5433
API_HTTP_PORT=3001
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000

# For running Node directly, use the runtime role in DATABASE_URL.
# DATABASE_URL=postgresql://derslik_app:YOUR_APP_PASSWORD@127.0.0.1:5433/derslik
# DATABASE_ADMIN_URL=postgresql://postgres:YOUR_ADMIN_PASSWORD@127.0.0.1:5433/derslik
# DATABASE_SSL=false

# Shared web / auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_BIND_ADDRESS=0.0.0.0
# Leave blank to detect this computer; override for emulator/phone routing.
MOBILE_API_HOST=
# Leave blank for local API; set one HTTPS URL for remote web/mobile.
API_PUBLIC_URL=
WEB_HTTP_PORT=3000
# Backend-only optional providers
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=derslik-materials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
