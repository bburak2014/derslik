# Generated from root .env.api by pnpm env:sync; configure that file first.
# Public values embedded in the app. Never put service/API secrets here.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3001
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
