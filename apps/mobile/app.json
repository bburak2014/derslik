{
  "expo": {
    "name": "Tutorwise",
    "slug": "derslik",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "derslik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.derslik.app"
    },
    "android": {
      "package": "com.derslik.app",
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tutorwise, vitrin profilinize fotoğraf eklemek için galerinize erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
