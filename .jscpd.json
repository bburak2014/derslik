{
  "minTokens": 50,
  "minLines": 5,
  "maxSize": "2mb",
  "maxLines": 100000,
  "format": ["typescript", "tsx", "javascript", "css"],
  "path": [
    "apps",
    "packages",
    "scripts",
    "tests",
    "build",
    "next.config.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "eslint.config.mjs",
    "postcss.config.mjs"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.api-build/**",
    "**/dist/**",
    "**/drizzle/**",
    "**/android/**",
    "**/components/ui/**",
    "**/vendor/**",
    "**/i18n/**"
  ],
  "reporters": ["console", "json", "html"],
  "output": "reports/jscpd",
  "gitignore": true
}
